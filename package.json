{
  "name": "ugc-community",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "BETTER_AUTH_URL=https://ugc.community NEXT_PUBLIC_APP_URL=https://ugc.community NEXT_PUBLIC_DOMAIN=ugc.community opennextjs-cloudflare build",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "./scripts/deploy-with-indexnow.sh",
    "deploy:worker": "pnpm cf:build && opennextjs-cloudflare deploy",
    "upload": "pnpm cf:build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate:single-portfolio": "npx tsx scripts/migrate-single-portfolio.ts",
    "portfolio:config:init": "tsx scripts/generate-portfolio-upload-config.ts",
    "portfolio:upload": "tsx scripts/upload-portfolio.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.0.1",
    "better-auth": "^1.2.8",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "framer-motion": "^11.18.0",
    "gray-matter": "^4.0.3",
    "inngest": "^3.50.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.11",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "wrangler": "4.113.0"
  }
}
