{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://isolated.tech https://*.isolated.tech"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-views",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/profile-monitoring",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/portfolio-enforcement",
      "schedule": "0 4 * * *"
    }
  ]
}
