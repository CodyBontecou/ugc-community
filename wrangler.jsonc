{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./cloudflare-worker.ts",
  "name": "ugc-community",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ugc-community"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ugc-community-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "ugc.community",
      "custom_domain": true
    },
    {
      "pattern": "www.ugc.community",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *", "0 4 * * *", "0 6 * * *"]
  }
}
