{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./cloudflare-worker.ts",
  "name": "ugc-community",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ugc-community"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ugc-community-opennext-cache"
    },
    {
      "binding": "SUBSCRAPE_EXPORTS",
      "bucket_name": "subscrape-exports"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "ugc.community",
      "custom_domain": true
    },
    {
      "pattern": "www.ugc.community",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *",
      "*/10 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "CREATOR_DATABASE",
      "database_name": "ugc-creator-database",
      "database_id": "b41d700a-d7e3-4c3e-b71a-43602ae5db56",
      "migrations_dir": "migrations/creator-database"
    },
    {
      "binding": "JOB_BOARD",
      "database_name": "ugc-job-board",
      "database_id": "2de569eb-1427-466c-bc02-72bc0c4ded96",
      "migrations_dir": "migrations/job-board"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "472913",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@ugc.community"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
