# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# GitHub OAuth (for admin deployment management)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Claude AI (for portfolio generation)
ANTHROPIC_API_KEY=""

# Creator Registration (for GitHub Actions auto-registration)
# Generate with: openssl rand -base64 32
CREATOR_REGISTRATION_SECRET=""

# Admin Panel (comma-separated list of admin emails)
ADMIN_EMAILS=""

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL="welcome@ugc.community"
FROM_NAME="ugc.community"

# Vercel API (for subdomain management)
# Create at: https://vercel.com/account/tokens
VERCEL_API_TOKEN=""
# Optional: Required if using a team account
VERCEL_TEAM_ID=""

# Domain Configuration
# The base domain for creator subdomains (e.g., "ugc.community")
NEXT_PUBLIC_DOMAIN="ugc.community"
